---
manufacturers:
  - "!create_or_update:name": "Cisco"
  - "!create_or_update:name": "Arista"

platforms:
  - "!create_or_update:name": "cisco_iosxe"
    manufacturer__name: "Cisco"
    network_driver: "cisco_ios"
  - "!create_or_update:name": "arista_eos"
    manufacturer__name: "Arista"
    network_driver: "arista_eos"

device_types:
  - "!create_or_update:model": "CAT8000v"
    manufacturer__name: "Cisco"
    u_height: 1
  - "!create_or_update:model": "vEOS"
    manufacturer__name: "Arista"
    u_height: 1

roles:
{% for role_name in ["P-Router", "PE-Router", "Route-Reflector", "CE-Router", "Border-Router", "Spine", "Leaf"] %}
  - "!create_or_update:name": "{{ role_name }}"
    content_types:
      - "!get:app_label": "dcim"
        "!get:model": "device"
{% endfor %}

location_types:
  - "!create_or_update:name": "Region"
    nestable: true
    content_types:
      - "!get:app_label": "dcim"
        "!get:model": "device"
    children:
      - "!create_or_update:name": "Site"
        content_types:
          - "!get:app_label": "dcim"
            "!get:model": "device"
          - "!get:app_label": "ipam"
            "!get:model": "prefix"
          - "!get:app_label": "ipam"
            "!get:model": "vlan"
    locations:
      - "!create_or_update:name": "SP-Demo-Lab"
        status__name: "Active"
        "!ref": "region"
        children:
          - "!create_or_update:name": "SP-Core"
            location_type__name: "Site"
            status__name: "Active"
            "!ref": "sp_core"
          - "!create_or_update:name": "DC-A"
            location_type__name: "Site"
            status__name: "Active"
            "!ref": "dc_a"
          - "!create_or_update:name": "DC-B"
            location_type__name: "Site"
            status__name: "Active"
            "!ref": "dc_b"
          - "!create_or_update:name": "DC-C"
            location_type__name: "Site"
            status__name: "Active"
            "!ref": "dc_c"

vrfs:
{% for vrf in vrfs %}
  - "!create_or_update:name": "{{ vrf.name }}"
    rd: "{{ vrf.rd }}"
    status__name: "Active"
{% endfor %}

prefixes:
  - "!create_or_update:prefix": "192.168.3.0/24"
    status__name: "Active"
    description: "OOB Management"
    vrf_assignments:
      - "!create_or_update:vrf__name": "MGMT-VRF"
  - "!create_or_update:prefix": "10.0.0.0/24"
    status__name: "Active"
    description: "SP Core P2P"
  - "!create_or_update:prefix": "10.1.0.0/24"
    status__name: "Active"
    description: "SP Core Loopbacks"
  # DC fabric P2P underlay (/31s assigned in 0003_cabling)
  - "!create_or_update:prefix": "10.1.1.0/24"
    status__name: "Active"
    description: "DC-A Fabric P2P"
  - "!create_or_update:prefix": "10.1.2.0/24"
    status__name: "Active"
    description: "DC-B Fabric P2P"
  - "!create_or_update:prefix": "10.1.3.0/24"
    status__name: "Active"
    description: "DC-C Fabric P2P"
  # CE + DC fabric loopbacks (/32s assigned in 0002_devices)
  - "!create_or_update:prefix": "10.2.1.0/24"
    status__name: "Active"
    description: "DC-A Loopbacks"
  - "!create_or_update:prefix": "10.2.2.0/24"
    status__name: "Active"
    description: "DC-B Loopbacks"
  - "!create_or_update:prefix": "10.2.3.0/24"
    status__name: "Active"
    description: "DC-C Loopbacks"
  # VTEP Loopback1 IPs (/32s assigned in 0002_devices, leaves only)
  - "!create_or_update:prefix": "10.3.1.0/24"
    status__name: "Active"
    description: "DC-A VTEP Loopbacks"
  - "!create_or_update:prefix": "10.3.2.0/24"
    status__name: "Active"
    description: "DC-B VTEP Loopbacks"
  - "!create_or_update:prefix": "10.3.3.0/24"
    status__name: "Active"
    description: "DC-C VTEP Loopbacks"
  # PE-CE handoffs (/31s assigned in 0003_cabling)
  - "!create_or_update:prefix": "172.16.1.0/24"
    status__name: "Active"
    description: "CUST-A PE-CE"
    vrf_assignments:
      - "!create_or_update:vrf__name": "CUST-A"
  - "!create_or_update:prefix": "172.16.2.0/24"
    status__name: "Active"
    description: "CUST-B PE-CE"
    vrf_assignments:
      - "!create_or_update:vrf__name": "CUST-B"
  - "!create_or_update:prefix": "172.16.3.0/24"
    status__name: "Active"
    description: "CUST-C PE-CE"
    vrf_assignments:
      - "!create_or_update:vrf__name": "CUST-C"
  # IPv6 parent prefixes
{% for pfx in ipv6_prefixes %}
  - "!create_or_update:prefix": "{{ pfx.prefix }}"
    status__name: "Active"
    description: "{{ pfx.description }}"
{% endfor %}
