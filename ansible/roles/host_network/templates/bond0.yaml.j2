#jinja2: trim_blocks: True, lstrip_blocks: True
# Managed by Ansible (host_network role). Sourced from Nautobot.
# Server data-plane bond: {{ bond_members | join(' + ') }} as a static LAG.
# The server is not VLAN-aware; VLAN 100 tagging is on the Arista leaf ports.
network:
  version: 2
  ethernets:
    {% for nic in bond_members %}
    {{ nic }}:
      dhcp4: false
      dhcp6: false
      mtu: {{ bond_mtu }}
    {% endfor %}
  bonds:
    bond0:
      interfaces: [{{ bond_members | join(', ') }}]
      macaddress: "{{ bond_mac }}"
      mtu: {{ bond_mtu }}
      addresses:
        - "{{ bond_ipv4 }}"
        {% if bond_ipv6 | length > 0 %}
        - "{{ bond_ipv6 }}"
        {% endif %}
      nameservers:
        addresses:
          - {{ lab_dns_server }}
        search:
          - {{ lab_domain }}
      routes:
        - to: default
          via: {{ bond_gateway }}
        {% if bond_ipv6 | length > 0 %}
        - to: "::/0"
          via: "{{ bond_gateway6 }}"
        {% endif %}
      parameters:
        mode: balance-xor
        transmit-hash-policy: layer3+4
        mii-monitor-interval: 100
