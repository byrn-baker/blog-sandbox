{% for bgp in bgp_routing_instances %}
router bgp {{ bgp.autonomous_system.asn }}
 bgp router-id {{ bgp.router_id.address.split('/')[0] }}
{% if config_context.bgp is defined %}
{% if config_context.bgp.log_neighbor_changes | default(true) %}
 bgp log-neighbor-changes
{% endif %}
{% if not config_context.bgp.default_ipv4_unicast | default(false) %}
 no bgp default ipv4-unicast
{% endif %}
 timers bgp {{ config_context.bgp.timers.keepalive }} {{ config_context.bgp.timers.hold }}
{% else %}
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 timers bgp 10 30
{% endif %}
!
{% for pg in bgp.peer_groups %}
 neighbor {{ pg.name }} peer-group
{% if pg.autonomous_system %}
 neighbor {{ pg.name }} remote-as {{ pg.autonomous_system.asn }}
{% endif %}
 neighbor {{ pg.name }} update-source Loopback0
{% if config_context.bfd is defined %}
 neighbor {{ pg.name }} fall-over bfd
{% endif %}
{% endfor %}
!
{% for endpoint in bgp.endpoints %}
{% if endpoint.peering and endpoint.peering.endpoints %}
{% set remote = namespace(ep=none) %}
{% for ep in endpoint.peering.endpoints %}
{% if ep.source_ip.address != endpoint.source_ip.address %}
{% set remote.ep = ep %}
{% endif %}
{% endfor %}
{% if remote.ep %}
{% set peer_ip = remote.ep.source_ip.address.split('/')[0] %}
{% if endpoint.peer_group %}
 neighbor {{ peer_ip }} peer-group {{ endpoint.peer_group.name }}
{% else %}
 neighbor {{ peer_ip }} remote-as {{ remote.ep.routing_instance.autonomous_system.asn }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
!
{% for pg in bgp.peer_groups %}
{% for af in pg.address_families %}
{% if af.afi_safi in ['VPNV4_UNICAST', 'vpnv4_unicast'] %}
 address-family vpnv4
{% for endpoint in bgp.endpoints %}
{% if endpoint.peer_group and endpoint.peer_group.name == pg.name and endpoint.peering %}
{% set remote = namespace(ep=none) %}
{% for ep in endpoint.peering.endpoints %}
{% if ep.source_ip.address != endpoint.source_ip.address %}
{% set remote.ep = ep %}
{% endif %}
{% endfor %}
{% if remote.ep %}
{% set peer_ip = remote.ep.source_ip.address.split('/')[0] %}
  neighbor {{ peer_ip }} activate
  neighbor {{ peer_ip }} send-community extended
{% if 'RR' in hostname or 'Route-Reflector' in role.name %}
  neighbor {{ peer_ip }} route-reflector-client
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
 exit-address-family
!
{% elif af.afi_safi in ['VPNV6_UNICAST', 'vpnv6_unicast'] %}
 address-family vpnv6
{% for endpoint in bgp.endpoints %}
{% if endpoint.peer_group and endpoint.peer_group.name == pg.name and endpoint.peering %}
{% set remote = namespace(ep=none) %}
{% for ep in endpoint.peering.endpoints %}
{% if ep.source_ip.address != endpoint.source_ip.address %}
{% set remote.ep = ep %}
{% endif %}
{% endfor %}
{% if remote.ep %}
{% set peer_ip = remote.ep.source_ip.address.split('/')[0] %}
  neighbor {{ peer_ip }} activate
  neighbor {{ peer_ip }} send-community extended
{% if 'RR' in hostname or 'Route-Reflector' in role.name %}
  neighbor {{ peer_ip }} route-reflector-client
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
 exit-address-family
!
{% endif %}
{% endfor %}
{% endfor %}
{% for endpoint in bgp.endpoints %}
{% if not endpoint.peer_group and endpoint.peering and endpoint.peering.endpoints %}
{% set remote = namespace(ep=none) %}
{% for ep in endpoint.peering.endpoints %}
{% if ep.source_ip.address != endpoint.source_ip.address %}
{% set remote.ep = ep %}
{% endif %}
{% endfor %}
{% if remote.ep %}
{% set peer_ip = remote.ep.source_ip.address.split('/')[0] %}
{% set source_ip = endpoint.source_ip.address.split('/')[0] %}
{% set found_vrf = namespace(yes=false) %}
{% for interface in interfaces if interface.vrf %}
{% for addr in interface.ip_addresses if addr.ip_version == 4 %}
{% if addr.address.split('/')[0] == source_ip %}
{% set found_vrf.yes = true %}
 address-family ipv4 vrf {{ interface.vrf.name }}
  neighbor {{ peer_ip }} remote-as {{ remote.ep.routing_instance.autonomous_system.asn }}
  neighbor {{ peer_ip }} activate
 exit-address-family
!
{% endif %}
{% endfor %}
{% endfor %}
{% if not found_vrf.yes %}
 address-family ipv4
  neighbor {{ peer_ip }} activate
 exit-address-family
!
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
