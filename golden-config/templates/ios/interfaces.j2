{# Interface configuration: management, loopbacks, P2P links, PE-CE, NAT roles #}
{% for interface in interfaces %}
{% set interface_role = interface.role | default(none) %}
{% set interface_role_name = interface_role.name if interface_role else '' %}
{% set is_nat_inside = interface_role_name == 'NAT Inside' %}
{% set is_nat_outside = interface_role_name == 'NAT Outside' %}
{% if interface.ip_addresses or interface.description or is_nat_inside or is_nat_outside or interface.name.startswith('GigabitEthernet') %}
interface {{ interface.name }}
{% if interface.description %}
 description {{ interface.description }}
{% endif %}
{% if interface.vrf %}
 vrf forwarding {{ interface.vrf.name }}
{% endif %}
{# No interface MTU override on the SP core. These links ride the CML vmxnet3   #}
{# virtual NIC, which silently drops frames larger than ~2034 bytes, so a jumbo #}
{# interface MTU breaks ISIS (hellos pad to the interface MTU and are dropped). #}
{# The core stays at the 1500 default. VXLAN overhead for the inter-DC EVPN DCI #}
{# is handled at the edge (host MTU) rather than by raising the underlay.       #}
{% set has_ipv4 = interface.ip_addresses | selectattr('ip_version', 'equalto', 4) | list | length > 0 %}
{% if not interface.enabled and not has_ipv4 and interface.name.startswith('GigabitEthernet') %}
 no ip address
{% endif %}
{% if not interface.enabled %}
 shutdown
{% endif %}
{% for addr in interface.ip_addresses %}
{% if addr.ip_version == 4 %}
{% set ip_parts = addr.address.split('/') %}
{% set prefix_len = ip_parts[1] | int %}
{% if prefix_len == 32 %}
 ip address {{ ip_parts[0] }} 255.255.255.255
{% elif prefix_len == 31 %}
 ip address {{ ip_parts[0] }} 255.255.255.254
{% elif prefix_len == 24 %}
 ip address {{ ip_parts[0] }} 255.255.255.0
{% endif %}
{% elif addr.ip_version == 6 %}
 ipv6 address {{ addr.address | upper }}
{% endif %}
{% endfor %}
{% set interface_custom_fields = interface._custom_field_data | default({}) %}
{% if is_nat_outside and interface_custom_fields.ip_address_mode | default('') == 'dhcp' %}
 ip address dhcp
{% endif %}
{% if is_nat_inside %}
 ip nat inside
{% elif is_nat_outside %}
 ip nat outside
{% endif %}
{# ISIS + MPLS on SP core interfaces (non-VRF, non-management, with 10.0.0.x IPs) #}
{% if not interface.vrf and not interface.mgmt_only and interface.name != 'Loopback0' and config_context.isis is defined %}
{% set ns = namespace(is_core=false) %}
{% for addr in interface.ip_addresses if addr.ip_version == 4 %}
{% if addr.address.startswith('10.0.0.') %}
{% set ns.is_core = true %}
{% endif %}
{% endfor %}
{% if ns.is_core %}
 ip router isis {{ config_context.isis.process_name }}
{% set has_ipv6 = interface.ip_addresses | selectattr('ip_version', 'equalto', 6) | list | length > 0 %}
{% if has_ipv6 %}
 ipv6 router isis {{ config_context.isis.process_name }}
{% endif %}
 isis network point-to-point
 mpls ip
{% if config_context.bfd is defined %}
 bfd interval {{ config_context.bfd.interval }} min_rx {{ config_context.bfd.min_rx }} multiplier {{ config_context.bfd.multiplier }}
{% if not (config_context.bfd.echo | default(true)) %}
 no bfd echo
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{# Loopback0 — ISIS passive (IPv4 + IPv6) #}
{% if interface.name == 'Loopback0' and config_context.isis is defined %}
 ip router isis {{ config_context.isis.process_name }}
{% set has_ipv6 = interface.ip_addresses | selectattr('ip_version', 'equalto', 6) | list | length > 0 %}
{% if has_ipv6 %}
 ipv6 router isis {{ config_context.isis.process_name }}
{% endif %}
{% endif %}
{# Negotiation auto on GigabitEthernet interfaces #}
{% if interface.name.startswith('GigabitEthernet') %}
 negotiation auto
{% endif %}
!
{% endif %}
{% endfor %}
