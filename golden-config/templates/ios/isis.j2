{# IS-IS router configuration — driven by config_context.isis #}
{% if igp_routing_instances and config_context.isis is defined %}
{% for igp in igp_routing_instances %}
{% if igp.protocol == "ISIS" %}
{% for isis_cfg in igp.isisconfiguration_set %}
router isis {{ config_context.isis.process_name }}
 net 49.0001.{{ isis_cfg.system_id }}.00
 is-type {{ config_context.isis.is_type }}
 metric-style {{ config_context.isis.metric_style }}
{% if config_context.isis.log_adjacency_changes | default(true) %}
 log-adjacency-changes
{% endif %}
 passive-interface Loopback0
{% if config_context.bfd is defined %}
 bfd all-interfaces
{% endif %}
{% if config_context.mpls is defined and config_context.mpls.ldp_sync | default(false) %}
 mpls ldp sync
{% endif %}
 !
 address-family ipv6
  multi-topology
 exit-address-family
!
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
