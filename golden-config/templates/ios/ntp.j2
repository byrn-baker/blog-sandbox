{# IOS-XE VRF-scoped NTP selects its source from the VRF route. #}
{# CAT8000v 17.15.1a rejects a per-server source option with vrf. #}
{% if config_context.ntp is defined %}
{% set ntp = config_context.ntp %}
{% for server in ntp.servers %}
{% if ntp.vrf | default('') %}
ntp server vrf {{ ntp.vrf }} {{ server }}
{% else %}
ntp server {{ server }} source {{ ntp.source_interface }}
{% endif %}
{% endfor %}
!
{% endif %}
