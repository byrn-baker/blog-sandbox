{# NTP transport uses standard UDP/123. VRF and source are explicit policy. #}
{% if config_context.ntp is defined %}
{% set ntp = config_context.ntp %}
{% for server in ntp.servers %}
ntp server{% if ntp.vrf | default('') %} vrf {{ ntp.vrf }}{% endif %} {{ server }} source {{ ntp.source_interface }}
{% endfor %}
!
{% endif %}
