{# Interface configuration (AVD-aligned) #}
{#                                                                          #}
{# EVPN ESI server bonds require explicit LAG membership on both sides of  #}
{# the cable. The leaf Ethernet must belong to a Port-Channel, and the      #}
{# connected server NIC must belong to bond0. The Port-Channel number comes #}
{# from the leaf interface's modeled LAG parent. Its ESI comes from the     #}
{# server's VLAN 100 host octet in config_context.server_esi_octets.        #}
{% set esi = namespace(members={}, pos={}) %}
{% set esi_octets = config_context.server_esi_octets | default({}) %}
{% set esi_vlan = config_context.server_esi_vlan | default(100) %}
{% for interface in interfaces if interface.name.startswith('Ethernet') and interface.lag is defined and interface.lag and interface.connected_interface is defined and interface.connected_interface %}
{% set peer = interface.connected_interface.device.name %}
{% set peer_lag = interface.connected_interface.lag.name if interface.connected_interface.lag is defined and interface.connected_interface.lag else '' %}
{% set local_lag = interface.lag.name %}
{% if peer in esi_octets and peer_lag == 'bond0' and local_lag.startswith('Port-Channel') %}
{% set idx = local_lag | replace('Port-Channel', '') %}
{% set oct = esi_octets[peer] %}
{% set _ = esi.members.update({interface.name: idx}) %}
{% set _ = esi.pos.update({idx: {'octet': oct, 'server': peer}}) %}
{% endif %}
{% endfor %}
{# Render each ESI Port-Channel first (access port in the server VLAN + ES). #}
{% for idx, info in esi.pos | dictsort %}
interface Port-Channel{{ idx }}
   description {{ info.server }} EVPN ESI multihome
   switchport access vlan {{ esi_vlan }}
   !
   evpn ethernet-segment
      identifier 00{{ info.octet }}:00{{ info.octet }}:00{{ info.octet }}:00{{ info.octet }}:00{{ info.octet }}
      route-target import 00:{{ info.octet }}:00:{{ info.octet }}:00:{{ info.octet }}
!
{% endfor %}
{# Render an interface when it carries config, or when it is a physical    #}
{# Ethernet port that exists on the box. Unused physical ports render as a  #}
{# plain `shutdown` so compliance sees them present, not extra.            #}
{% for interface in interfaces %}
{# Port-Channels are rendered above with their ethernet-segment; skip here so #}
{# they don't emit a second bare block. #}
{% if interface.name.startswith('Port-Channel') %}
{% elif interface.ip_addresses or interface.description or interface.name.startswith('Ethernet') %}
interface {{ interface.name }}
{% if interface.description %}
   description {{ interface.description }}
{% endif %}
{% if interface.vrf %}
   vrf {{ interface.vrf.name }}
{% endif %}
{% if not interface.enabled %}
   shutdown
{% endif %}
{% if interface.name in esi.members %}
   channel-group {{ esi.members[interface.name] }} mode on
{% endif %}
{% if interface.name.startswith('Ethernet') and interface.ip_addresses %}
{# Default fabric MTU is 8950, not the 9214 EOS jumbo default. Every virtual wire
   under this fabric is MTU 9000: the EVE-NG vnet bridges and vunl taps carrying
   the leaf-spine links, the ethN/pnetN interfaces, and Proxmox vmbr0/eno1. At
   9214 the leaf-spine BGP sessions derived a TCP MSS of 9162, so a full-size
   EVPN UPDATE became a 9202-byte packet that the Linux bridge silently dropped.
   No ICMP frag-needed comes back from a bridge, so PMTUD blackholed: the output
   queue never drained, keepalives stalled behind it, and the session reset on
   hold-timer expiry forever. 8950 leaves headroom under the 9000 ceiling.
   Any device that needs something else carries an explicit Interface.mtu in
   Nautobot, which wins over this default (e.g. spine Et10 to the CE at 1500). #}
   mtu {{ interface.mtu | default(8950, true) }}
   no switchport
{% endif %}
{% for addr in interface.ip_addresses %}
{% if addr.ip_version == 4 %}
{% if interface.name.startswith('Vlan') %}
   ip address virtual {{ addr.address }}
{% else %}
   ip address {{ addr.address }}
{% endif %}
{% elif addr.ip_version == 6 %}
{% if interface.name.startswith('Vlan') %}
   ipv6 address virtual {{ addr.address }}
{% else %}
   ipv6 address {{ addr.address }}
{% endif %}
{% endif %}
{% endfor %}
{# VLAN 100 exports its learned host routes so each site can originate the  #}
{# per-host /32 that steers internet return traffic back to the owning DC.  #}
{% if interface.name == 'Vlan100' %}
   ip attached-host route export
{% endif %}
!
{% endif %}
{% endfor %}
