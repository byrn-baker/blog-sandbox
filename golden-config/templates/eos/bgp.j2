{% set device_tag_names = tags | default([]) | map(attribute='name') | list %}
{% set internet_origin = config_context.internet_egress is defined and 'internet-egress-origin' in device_tag_names %}
{% set internet_services = namespace(vrfs=[]) %}
{% if internet_origin %}
{% for interface in interfaces if interface.enabled and interface.vrf %}
{% set interface_tag_names = interface.tags | default([]) | map(attribute='name') | list %}
{% if 'internet-service' in interface_tag_names %}
{% for address in interface.ip_addresses if address.ip_version == 4 and address.parent %}
{% if interface.vrf.name not in internet_services.vrfs %}
{% set internet_services.vrfs = internet_services.vrfs + [interface.vrf.name] %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% for bgp in bgp_routing_instances %}
router bgp {{ bgp.autonomous_system.asn }}
   router-id {{ bgp.router_id.address.split('/')[0] }}
{% if config_context.bgp is defined and not config_context.bgp.default_ipv4_unicast | default(false) %}
   no bgp default ipv4-unicast
{% endif %}
{% if config_context.bgp is defined %}
   maximum-paths {{ config_context.bgp.maximum_paths | default(4) }} ecmp {{ config_context.bgp.ecmp | default(4) }}
   timers bgp {{ config_context.bgp.timers.keepalive }} {{ config_context.bgp.timers.hold }}
{% else %}
   maximum-paths 4 ecmp 4
   timers bgp 3 9
{% endif %}
!
{% for pg in bgp.peer_groups %}
   neighbor {{ pg.name }} peer group
{% set pg_afs = pg.address_families | map(attribute='afi_safi') | list %}
{% if 'L2_EVPN' in pg_afs or 'l2_evpn' in pg_afs %}
   neighbor {{ pg.name }} update-source Loopback0
{% if role.name == 'Spine' %}
   neighbor {{ pg.name }} next-hop-unchanged
{% endif %}
   neighbor {{ pg.name }} bfd
   neighbor {{ pg.name }} ebgp-multihop 3
   neighbor {{ pg.name }} send-community extended
   neighbor {{ pg.name }} maximum-routes 0
{% else %}
   neighbor {{ pg.name }} send-community
   neighbor {{ pg.name }} maximum-routes 12000
{% endif %}
!
{% endfor %}
{% for endpoint in bgp.endpoints %}
{% if endpoint.peering and endpoint.peering.endpoints %}
{% set remote = namespace(ep=none) %}
{% for ep in endpoint.peering.endpoints %}
{% if ep.source_ip.address != endpoint.source_ip.address %}
{% set remote.ep = ep %}
{% endif %}
{% endfor %}
{% if remote.ep %}
{% set peer_ip = remote.ep.source_ip.address.split('/')[0] %}
{% if endpoint.peer_group %}
   neighbor {{ peer_ip }} peer group {{ endpoint.peer_group.name }}
   neighbor {{ peer_ip }} remote-as {{ remote.ep.routing_instance.autonomous_system.asn }}
   neighbor {{ peer_ip }} description {{ remote.ep.routing_instance.device.name }}
{% else %}
   neighbor {{ peer_ip }} remote-as {{ remote.ep.routing_instance.autonomous_system.asn }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
!
{% if config_context.bgp is defined and config_context.bgp.redistribute is defined and config_context.bgp.redistribute.connected is defined %}
   redistribute connected route-map {{ config_context.bgp.redistribute.connected.route_map }}
{% endif %}
!
{% set address_families = namespace(ipv4=[], evpn=[]) %}
{% for pg in bgp.peer_groups %}
{% for af in pg.address_families %}
{% if af.afi_safi in ['L2_EVPN', 'l2_evpn'] and pg.name not in address_families.evpn %}
{% set address_families.evpn = address_families.evpn + [pg.name] %}
{% elif af.afi_safi in ['IPV4_UNICAST', 'ipv4_unicast'] and pg.name not in address_families.ipv4 %}
{% set address_families.ipv4 = address_families.ipv4 + [pg.name] %}
{% endif %}
{% endfor %}
{% endfor %}
{% if address_families.evpn %}
   address-family evpn
{% for peer_group_name in address_families.evpn %}
      neighbor {{ peer_group_name }} activate
{% endfor %}
   !
{% endif %}
{% if address_families.ipv4 %}
   address-family ipv4
{% for peer_group_name in address_families.ipv4 %}
      neighbor {{ peer_group_name }} activate
{% endfor %}
      redistribute connected
{% if internet_origin and internet_services.vrfs %}
      redistribute static route-map {{ config_context.internet_egress.reverse_route.route_map }}
{% endif %}
   !
{% endif %}
{% if not bgp.peer_groups %}
   address-family ipv4
      redistribute connected
   !
   address-family evpn
   !
{% endif %}
{% if config_context.vxlan is defined %}
{% for vlan in location.vlans | default([]) if vlan._custom_field_data.vni is defined %}
   vlan {{ vlan.vid }}
      rd {{ bgp.router_id.address.split('/')[0] }}:{{ vlan._custom_field_data.vni }}
      route-target both {{ vlan._custom_field_data.vni }}:{{ vlan._custom_field_data.vni }}
      redistribute learned
   !
{% endfor %}
{% for vrf in vrfs | default([]) if vrf._custom_field_data.vni is defined and vrf._custom_field_data.vni is not none %}
   vrf {{ vrf.name }}
      rd {{ bgp.router_id.address.split('/')[0] }}:{{ vrf._custom_field_data.vni }}
      route-target import evpn {{ vrf._custom_field_data.vni }}:{{ vrf._custom_field_data.vni }}
      route-target export evpn {{ vrf._custom_field_data.vni }}:{{ vrf._custom_field_data.vni }}
      redistribute connected
{% if internet_origin and vrf.name in internet_services.vrfs %}
      redistribute static route-map {{ config_context.internet_egress.default_route.route_map }}
{% endif %}
   !
{% endfor %}
{% endif %}
{% endfor %}
