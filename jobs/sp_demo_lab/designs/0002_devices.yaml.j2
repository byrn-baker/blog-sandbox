---
# SP Core devices — Cisco CAT8000v (IOS-XE)
{% set site_refs = {"SP-Core": "sp_core", "DC-A": "dc_a", "DC-B": "dc_b", "DC-C": "dc_c"} %}

{% macro cisco_device(device) -%}
  - "!create_or_update:name": "{{ device.name }}"
    location: "!ref:{{ site_refs[device.site] }}"
    device_type__model: "CAT8000v"
    role__name: "{{ device.role }}"
    status__name: "Active"
    platform__name: "cisco_iosxe"
    vrf_assignments:
      - "!create_or_update:vrf__name": "MGMT-VRF"
{% if device.name == internet_edge.device %}
      - "!create_or_update:vrf__name": "{{ internet_edge.vrf.name }}"
{% endif %}
    interfaces:
      - "!create_or_update:name": "GigabitEthernet1"
        status__name: "Active"
        type: "1000base-t"
        description: "Management - MGMT-VRF"
        vrf__name: "MGMT-VRF"
        ip_addresses:
          - "!create_or_update:address": "{{ device.ip }}/24"
            status__name: "Active"
      - "!create_or_update:name": "Loopback0"
        status__name: "Active"
        type: "virtual"
        description: "Router-ID"
        ip_addresses:
          - "!create_or_update:address": "{{ device.loopback }}/32"
            status__name: "Active"
          - "!create_or_update:address": "{{ device.loopback6 }}/128"
            status__name: "Active"
{% for i in range(2, (cisco_max_gi_port.get(device.name, 8)) + 1) %}
{% set interface_name = "GigabitEthernet" ~ i %}
      - "!create_or_update:name": "{{ interface_name }}"
{% if device.name == internet_edge.device and interface_name in internet_edge.inside_interfaces %}
        status__name: "Active"
        role__name: "NAT Inside"
{% elif device.name == internet_edge.device and interface_name == internet_edge.outside_interface.name %}
        status__name: "Active"
        role__name: "NAT Outside"
        description: "{{ internet_edge.outside_interface.description }}"
        custom_fields:
          ip_address_mode: "{{ internet_edge.outside_interface.address_mode }}"
{% else %}
        # Physical port present on the box but unused: Active status, admin-down.
        status__name: "Active"
        enabled: false
{% endif %}
        type: "1000base-t"
{% endfor %}
{%- endmacro %}

{% macro arista_device(device) -%}
  - "!create_or_update:name": "{{ device.name }}"
    location: "!ref:{{ site_refs[device.site] }}"
    device_type__model: "vEOS"
    role__name: "{{ device.role }}"
    status__name: "Active"
    platform__name: "arista_eos"
    vrf_assignments:
      - "!create_or_update:vrf__name": "MGMT-VRF"
{% if device.vtep is defined %}
      - "!create_or_update:vrf__name": "SERVERS"
{% endif %}
    interfaces:
      - "!create_or_update:name": "Management1"
        status__name: "Active"
        type: "1000base-t"
        description: "Management - MGMT-VRF"
        vrf__name: "MGMT-VRF"
        ip_addresses:
          - "!create_or_update:address": "{{ device.ip }}/24"
            status__name: "Active"
      - "!create_or_update:name": "Loopback0"
        status__name: "Active"
        type: "virtual"
        description: "Router-ID"
        ip_addresses:
          - "!create_or_update:address": "{{ device.loopback }}/32"
            status__name: "Active"
          - "!create_or_update:address": "{{ device.loopback6 }}/128"
            status__name: "Active"
{% if device.vtep is defined %}
      - "!create_or_update:name": "Loopback1"
        status__name: "Active"
        type: "virtual"
        description: "VTEP_VXLAN_Tunnel_Source"
        ip_addresses:
          - "!create_or_update:address": "{{ device.vtep }}/32"
            status__name: "Active"
{% for vlan in service_vlans if device.site in vlan.locations %}
      - "!create_or_update:name": "Vlan{{ vlan.id }}"
        status__name: "Active"
        type: "virtual"
        description: "{{ vlan.name }}"
{% if vlan.vrf is defined %}
        vrf__name: "{{ vlan.vrf }}"
{% endif %}
        ip_addresses:
          - "!create_or_update:address": "{{ vlan.ipv4_gateway }}"
            status__name: "Active"
          - "!create_or_update:address": "{{ vlan.ipv6_gateway }}"
            status__name: "Active"
{% endfor %}
{% endif %}
{% for i in range(1, 11) %}
      - "!create_or_update:name": "Ethernet{{ i }}"
        # Physical port present on the box but unused: Active status, admin-down.
        # 0003 flips cabled ports to enabled=true.
        status__name: "Active"
        enabled: false
        type: "1000base-t"
{% endfor %}
{%- endmacro %}

{% macro server_device(server) -%}
  - "!create_or_update:name": "{{ server.name }}"
    location: "!ref:{{ site_refs[server.site] }}"
    device_type__model: "Ubuntu-VM"
    role__name: "Server"
    status__name: "Active"
    interfaces:
      - "!create_or_update:name": "eth0"
        status__name: "Active"
        type: "virtual"
        description: "Management"
        ip_addresses:
          - "!create_or_update:address": "{{ server.mgmt }}/24"
            status__name: "Active"
      - "!create_or_update:name": "bond0"
        status__name: "Active"
        type: "lag"
        description: "VLAN100 EVPN ESI bond (static LAG)"
        ip_addresses:
          - "!create_or_update:address": "192.168.100.{{ server.host_octet }}/24"
            status__name: "Active"
      - "!create_or_update:name": "ens19"
        status__name: "Active"
        type: "virtual"
        description: "bond0 member -> {{ server.leaves[0] }} Ethernet{{ server.eth_index }}"
        lag__name: "bond0"
      - "!create_or_update:name": "ens20"
        status__name: "Active"
        type: "virtual"
        description: "bond0 member -> {{ server.leaves[1] }} Ethernet{{ server.eth_index }}"
        lag__name: "bond0"
{%- endmacro %}

devices:
{% for device in sp_core_devices %}
  {{ cisco_device(device) }}
{% endfor %}
{% for device in dc_a_devices %}
  {{ arista_device(device) }}
{% endfor %}
{% for device in dc_b_devices %}
  {{ arista_device(device) }}
{% endfor %}
{% for device in dc_c_devices %}
  {{ arista_device(device) }}
{% endfor %}
{% for server in servers %}
  {{ server_device(server) }}
{% endfor %}
