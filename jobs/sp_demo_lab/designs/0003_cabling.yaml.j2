---
# Inter-device cabling and P2P IP assignments.
# A-side gets the even IP (first host in the /31), B-side gets the odd.
#
# IMPORTANT: every link must render beneath a SINGLE top-level `devices:` and a
# SINGLE top-level `cables:` key. Emitting one `devices:`/`cables:` block per
# link produces duplicate top-level YAML keys, and the parser silently keeps
# only the last occurrence -- which drops every link but one.

{% set all_links = sp_core_links + dc_a_links + dc_b_links + dc_c_links %}

{% macro link_devices(a_dev, a_intf, b_dev, b_intf, prefix, v6_a, v6_b) -%}
{%- set octets = prefix.split('/')[0].split('.') -%}
{%- set net = octets[0] ~ '.' ~ octets[1] ~ '.' ~ octets[2] -%}
{%- set last = octets[3] | int -%}
- "!update:name": "{{ b_dev }}"
    interfaces:
      - "!update:name": "{{ b_intf }}"
        status__name: "Active"
        enabled: true
        description: "to {{ a_dev }} {{ a_intf }}"
        "!ref": "{{ b_dev }}_{{ b_intf | replace(' ', '_') }}"
        ip_addresses:
          - "!create_or_update:address": "{{ net }}.{{ last + 1 }}/31"
            status__name: "Active"
          - "!create_or_update:address": "{{ v6_b }}/127"
            status__name: "Active"
  - "!update:name": "{{ a_dev }}"
    interfaces:
      - "!update:name": "{{ a_intf }}"
        status__name: "Active"
        enabled: true
        description: "to {{ b_dev }} {{ b_intf }}"
        "!ref": "{{ a_dev }}_{{ a_intf | replace(' ', '_') }}"
        "!connect_cable":
          status__name: "Connected"
          to:
            device__name: "{{ b_dev }}"
            name: "{{ b_intf }}"
        ip_addresses:
          - "!create_or_update:address": "{{ net }}.{{ last }}/31"
            status__name: "Active"
          - "!create_or_update:address": "{{ v6_a }}/127"
            status__name: "Active"
{%- endmacro %}

devices:
{# Standard links (SP core + DC fabric) — no VRF #}
{% for link in all_links %}
  {{ link_devices(link[0], link[1], link[2], link[3], link[4], link[5], link[6]) }}
{% endfor %}
{# PE-CE links — PE interface in customer VRF #}
{% for link in pe_ce_links %}
{% set octets = link[4].split('/')[0].split('.') %}
{% set net = octets[0] ~ '.' ~ octets[1] ~ '.' ~ octets[2] %}
{% set last = octets[3] | int %}
  - "!update:name": "{{ link[2] }}"
    interfaces:
      - "!update:name": "{{ link[3] }}"
        status__name: "Active"
        enabled: true
        description: "PE-CE to {{ link[0] }} {{ link[1] }}"
        "!ref": "{{ link[2] }}_{{ link[3] | replace(' ', '_') }}"
        ip_addresses:
          - "!create_or_update:address": "{{ net }}.{{ last + 1 }}/31"
            status__name: "Active"
          - "!create_or_update:address": "{{ link[7] }}/127"
            status__name: "Active"
  - "!update:name": "{{ link[0] }}"
    vrf_assignments:
      - "!create_or_update:vrf__name": "{{ link[5] }}"
    interfaces:
      - "!update:name": "{{ link[1] }}"
        status__name: "Active"
        enabled: true
        description: "PE-CE to {{ link[2] }} {{ link[3] }} (VRF {{ link[5] }})"
        vrf__name: "{{ link[5] }}"
        "!ref": "{{ link[0] }}_{{ link[1] | replace(' ', '_') }}"
        "!connect_cable":
          status__name: "Connected"
          to:
            device__name: "{{ link[2] }}"
            name: "{{ link[3] }}"
        ip_addresses:
          - "!create_or_update:address": "{{ net }}.{{ last }}/31"
            status__name: "Active"
          - "!create_or_update:address": "{{ link[6] }}/127"
            status__name: "Active"
{% endfor %}
{# Server ESI links — each VM's two NICs to Ethernet<eth_index> on the two #}
{# leaves of its site. Each leaf gets a Port-Channel<eth_index> access port #}
{# in VLAN 100; the member Ethernet joins it as a LAG child and cables to the #}
{# server NIC. The evpn ethernet-segment + ESI render from context in the #}
{# golden-config EOS template, keyed off the same host octet. #}
{% for server in servers %}
{% set po = "Port-Channel" ~ server.eth_index %}
{% set member = "Ethernet" ~ server.eth_index %}
{% set nics = ["ens19", "ens20"] %}
{% for leaf in server.leaves %}
  - "!update:name": "{{ leaf }}"
    interfaces:
      - "!create_or_update:name": "{{ po }}"
        status__name: "Active"
        enabled: true
        type: "lag"
        mode: "access"
        description: "{{ server.name }} EVPN ESI multihome"
        untagged_vlan__vid: 100
      - "!update:name": "{{ member }}"
        status__name: "Active"
        enabled: true
        lag__name: "{{ po }}"
        description: "{{ server.name }} bond member (ESI multihome)"
        "!ref": "{{ leaf }}_{{ member }}"
  - "!update:name": "{{ server.name }}"
    interfaces:
      - "!update:name": "{{ nics[loop.index0] }}"
        status__name: "Active"
        enabled: true
        "!connect_cable":
          status__name: "Connected"
          to:
            device__name: "{{ leaf }}"
            name: "{{ member }}"
{% endfor %}
{% endfor %}

{# Border links — leaf Ethernet10 in SERVERS to CE GigabitEthernet5 (global). #}
{# Leaf side (.16) carries the /31 in SERVERS; CE side (.17) stays global. #}
{% for link in border_links %}
{% set octets = link[4].split('/')[0].split('.') %}
{% set net = octets[0] ~ '.' ~ octets[1] ~ '.' ~ octets[2] %}
{% set last = octets[3] | int %}
  - "!update:name": "{{ link[2] }}"
    interfaces:
      - "!update:name": "{{ link[3] }}"
        status__name: "Active"
        enabled: true
        description: "Border handoff to {{ link[0] }} {{ link[1] }}"
        "!ref": "{{ link[2] }}_{{ link[3] | replace(' ', '_') }}"
        ip_addresses:
          - "!create_or_update:address": "{{ net }}.{{ last + 1 }}/31"
            status__name: "Active"
  - "!update:name": "{{ link[0] }}"
    interfaces:
      - "!update:name": "{{ link[1] }}"
        status__name: "Active"
        enabled: true
        description: "Border handoff to {{ link[2] }} ({{ link[5] }})"
        vrf__name: "{{ link[5] }}"
        "!ref": "{{ link[0] }}_{{ link[1] | replace(' ', '_') }}"
        "!connect_cable":
          status__name: "Connected"
          to:
            device__name: "{{ link[2] }}"
            name: "{{ link[3] }}"
        ip_addresses:
          - "!create_or_update:address": "{{ net }}.{{ last }}/31"
            status__name: "Active"
{% endfor %}
