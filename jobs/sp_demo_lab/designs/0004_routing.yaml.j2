---
# ISIS and BGP routing model for the SP core.
# Uses nautobot-igp-models and nautobot-bgp-models.

# --- Autonomous Systems ---
autonomous_systems:
{% for asn in autonomous_systems %}
  - "!create_or_update:asn": {{ asn.asn }}
    description: "{{ asn.description }}"
    status__name: "Active"
{% endfor %}

# --- ISIS Routing Instances ---
igp_routing_instances:
{% for dev_name in isis_devices %}
{% set dev = sp_core_devices | selectattr("name", "equalto", dev_name) | first %}
  - "!create_or_update:device__name": "{{ dev_name }}"
    "!create_or_update:name": "{{ dev_name }}-ISIS"
    protocol: "ISIS"
    router_id__host: "{{ dev.loopback }}"
    isis_area: "{{ isis_area }}"
    status__name: "Active"
    description: "SP Core IS-IS Level-2"
{% endfor %}

# --- ISIS Configurations (with nested interface configs) ---
isis_configurations:
{% for dev_name in isis_devices %}
{% set dev = sp_core_devices | selectattr("name", "equalto", dev_name) | first %}
{% set sys_id_parts = dev.loopback.split('.') %}
  - "!create_or_update:instance__device__name": "{{ dev_name }}"
    "!create_or_update:instance__name": "{{ dev_name }}-ISIS"
    "!create_or_update:name": "{{ dev_name }}-ISIS-L2"
    system_id: "{{ '%04d' | format(sys_id_parts[2] | int) }}.{{ '%04d' | format(sys_id_parts[3] | int) }}.0001"
    status__name: "Active"
    default_metric: 10
    interface_configurations:
{% for link in sp_core_links %}
{% if link[0] == dev_name %}
      - "!create_or_update:name": "{{ dev_name }}-{{ link[1] }}"
        device__name: "{{ dev_name }}"
        interface:
          "!get:name": "{{ link[1] }}"
          "!get:device__name": "{{ dev_name }}"
        circuit_type: "L2"
        network_type: "point-to-point"
        metric: 10
        status__name: "Active"
{% endif %}
{% if link[2] == dev_name %}
      - "!create_or_update:name": "{{ dev_name }}-{{ link[3] }}"
        device__name: "{{ dev_name }}"
        interface:
          "!get:name": "{{ link[3] }}"
          "!get:device__name": "{{ dev_name }}"
        circuit_type: "L2"
        network_type: "point-to-point"
        metric: 10
        status__name: "Active"
{% endif %}
{% endfor %}
      - "!create_or_update:name": "{{ dev_name }}-Loopback0"
        device__name: "{{ dev_name }}"
        interface:
          "!get:name": "Loopback0"
          "!get:device__name": "{{ dev_name }}"
        circuit_type: "L2"
        network_type: "point-to-point"
        metric: 0
        status__name: "Active"
{% endfor %}

# --- BGP Routing Instances ---
# Instance-level knobs (timers, maximum-paths, redistribute, etc.) ride the
# routing instance's Extra Attributes, not config context.
bgp_routing_instances:
{% for inst in bgp_instances %}
  - "!create_or_update:device__name": "{{ inst.device }}"
    "!create_or_update:autonomous_system__asn": {{ inst.asn }}
    router_id__host: "{{ inst.router_id }}"
    description: "BGP on {{ inst.device }}"
    status__name: "Active"
    extra_attributes: {{ sp_bgp_instance_attrs | tojson }}
{% endfor %}
# DC Fabric
{% for inst in dc_bgp_instances %}
  - "!create_or_update:device__name": "{{ inst.device }}"
    "!create_or_update:autonomous_system__asn": {{ inst.asn }}
    router_id__host: "{{ inst.router_id }}"
    description: "BGP on {{ inst.device }}"
    status__name: "Active"
    extra_attributes: {{ dc_bgp_instance_attrs | tojson }}
{% endfor %}

# --- BGP Address Families ---
bgp_address_families:
{% for inst in bgp_instances %}
{% if inst.asn == 65000 %}
  - "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "vpnv4_unicast"
  - "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "vpnv6_unicast"
{% endif %}
{% endfor %}
{% for inst in bgp_instances %}
{% if inst.asn != 65000 %}
  - "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "ipv4_unicast"
{% endif %}
{% endfor %}
# BORDER1 Internet VRF default origination
  - "!create_or_update:routing_instance__device__name": "{{ internet_edge.device }}"
    "!create_or_update:afi_safi": "ipv4_unicast"
    "!create_or_update:vrf__name": "{{ internet_edge.vrf.name }}"
    extra_attributes:
      internet_edge: true
      networks:
{% for network in internet_edge.advertise_networks %}
        - "{{ network }}"
{% endfor %}
# DC Fabric: ipv4_unicast (underlay) + l2_evpn (overlay).
# The global ipv4 AF redistributes connected; that policy rides the AF model,
# not a template literal.
{% for inst in dc_bgp_instances %}
  - "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "ipv4_unicast"
    extra_attributes:
      redistribute:
        - "connected"
  - "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "l2_evpn"
{% endfor %}
# Every leaf runs the SERVERS L3 VRF, so each gets a SERVERS-VRF ipv4 AF
# whose redistribute connected pulls the server SVIs into EVPN. On the border
# leaf that same VRF AF also feeds the eBGP handoff to the CE.
{% for inst in dc_bgp_instances if "Leaf" in inst.device %}
  - "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "ipv4_unicast"
    "!create_or_update:vrf__name": "SERVERS"
    extra_attributes:
      redistribute:
        - "connected"
{% endfor %}

# --- BGP Peer Groups ---
# Peer-group tuning (send-community, maximum-routes, update-source,
# ebgp-multihop, bfd, next-hop-unchanged, fall-over bfd, rr-client) lives in
# the peer group's Extra Attributes, keyed off the group, not config context.
bgp_peer_groups:
{% for pe in ["SPE1", "SPE2", "SPE3", "BORDER1"] %}
  - "!create_or_update:name": "RR-CLIENTS"
    "!create_or_update:routing_instance__device__name": "{{ pe }}"
    description: "iBGP to Route Reflectors"
    enabled: true
    autonomous_system__asn: 65000
    extra_attributes: {{ sp_bgp_peer_group_attrs["RR-CLIENTS"] | tojson }}
{% endfor %}
{% for rr in ["RR1", "RR2"] %}
  - "!create_or_update:name": "PE-CLIENTS"
    "!create_or_update:routing_instance__device__name": "{{ rr }}"
    description: "iBGP PE clients"
    enabled: true
    autonomous_system__asn: 65000
    extra_attributes: {{ sp_bgp_peer_group_attrs["PE-CLIENTS"] | tojson }}
{% endfor %}
# DC Fabric peer groups (all spines and leaves get both underlay + overlay).
# Spines add next_hop_unchanged to the overlay group.
{% for inst in dc_bgp_instances %}
{% set is_spine = "Spine" in inst.device %}
  - "!create_or_update:name": "IPV4-UNDERLAY-PEERS"
    "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    description: "eBGP IPv4 underlay peers"
    enabled: true
    extra_attributes: {{ dc_bgp_peer_group_attrs["IPV4-UNDERLAY-PEERS"] | tojson }}
  - "!create_or_update:name": "EVPN-OVERLAY-PEERS"
    "!create_or_update:routing_instance__device__name": "{{ inst.device }}"
    description: "eBGP EVPN overlay peers"
    enabled: true
{% if is_spine %}
    extra_attributes: {{ dc_spine_overlay_attrs | tojson }}
{% else %}
    extra_attributes: {{ dc_bgp_peer_group_attrs["EVPN-OVERLAY-PEERS"] | tojson }}
{% endif %}
{% endfor %}

# --- BGP Peer Group Address Families ---
bgp_peer_group_address_families:
# SP Core: RR-CLIENTS and PE-CLIENTS need VPNv4 + VPNv6
{% for pe in ["SPE1", "SPE2", "SPE3", "BORDER1"] %}
  - "!create_or_update:peer_group__name": "RR-CLIENTS"
    "!create_or_update:peer_group__routing_instance__device__name": "{{ pe }}"
    "!create_or_update:afi_safi": "vpnv4_unicast"
  - "!create_or_update:peer_group__name": "RR-CLIENTS"
    "!create_or_update:peer_group__routing_instance__device__name": "{{ pe }}"
    "!create_or_update:afi_safi": "vpnv6_unicast"
{% endfor %}
{% for rr in ["RR1", "RR2"] %}
  - "!create_or_update:peer_group__name": "PE-CLIENTS"
    "!create_or_update:peer_group__routing_instance__device__name": "{{ rr }}"
    "!create_or_update:afi_safi": "vpnv4_unicast"
  - "!create_or_update:peer_group__name": "PE-CLIENTS"
    "!create_or_update:peer_group__routing_instance__device__name": "{{ rr }}"
    "!create_or_update:afi_safi": "vpnv6_unicast"
{% endfor %}
# DC Fabric: underlay = ipv4_unicast, overlay = l2_evpn
{% for inst in dc_bgp_instances %}
  - "!create_or_update:peer_group__name": "IPV4-UNDERLAY-PEERS"
    "!create_or_update:peer_group__routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "ipv4_unicast"
  - "!create_or_update:peer_group__name": "EVPN-OVERLAY-PEERS"
    "!create_or_update:peer_group__routing_instance__device__name": "{{ inst.device }}"
    "!create_or_update:afi_safi": "l2_evpn"
{% endfor %}

# --- BGP Peerings ---
bgp_peerings:
{% for peer in ibgp_peerings %}
  - status__name: "Active"
    endpoints:
      - routing_instance__device__name: "{{ peer.a_device }}"
        source_ip__host: "{{ peer.a_ip }}"
        peer_group:
          "!get:name": "RR-CLIENTS"
          "!get:routing_instance__device__name": "{{ peer.a_device }}"
        enabled: true
      - routing_instance__device__name: "{{ peer.b_device }}"
        source_ip__host: "{{ peer.b_ip }}"
        peer_group:
          "!get:name": "PE-CLIENTS"
          "!get:routing_instance__device__name": "{{ peer.b_device }}"
        enabled: true
{% endfor %}
{% for peer in ebgp_peerings %}
  - status__name: "Active"
    endpoints:
      - routing_instance__device__name: "{{ peer.pe }}"
        source_ip__host: "{{ peer.pe_ip }}"
        autonomous_system__asn: {{ peer.pe_asn }}
        enabled: true
      - routing_instance__device__name: "{{ peer.ce }}"
        source_ip__host: "{{ peer.ce_ip }}"
        autonomous_system__asn: {{ peer.ce_asn }}
        enabled: true
{% endfor %}

# --- Border handoff eBGP (border leaf SERVERS <-> CE global) ---
# The leaf peers from its SERVERS interface (.16); the EOS template renders
# it under `vrf SERVERS` because the source IP sits on an interface in that
# VRF. The CE peers globally (.17) and re-advertises into its PE-CE session.
{% for peer in border_ebgp_peerings %}
  - status__name: "Active"
    endpoints:
      - routing_instance__device__name: "{{ peer.leaf }}"
        source_ip__host: "{{ peer.leaf_ip }}"
        autonomous_system__asn: {{ peer.leaf_asn }}
        enabled: true
        extra_attributes:
          maximum_routes: 12000
      - routing_instance__device__name: "{{ peer.ce }}"
        source_ip__host: "{{ peer.ce_ip }}"
        autonomous_system__asn: {{ peer.ce_asn }}
        enabled: true
{% endfor %}

# =============================================================================
# DC Fabric BGP (Arista eBGP underlay + EVPN overlay)
# =============================================================================

# --- DC Underlay Peerings (eBGP, IPv4 unicast, source = P2P link IPs) ---
{% set dc_all_links = dc_a_links + dc_b_links + dc_c_links %}
{% for link in dc_all_links %}
{% set is_fabric_link = "Spine" in link[0] and "Leaf" in link[2] %}
{% set is_dci_link = link[0].startswith("CE") and "Spine" in link[2] %}
{% if is_fabric_link or is_dci_link %}
{% set prefix_parts = link[4].split('/')[0].split('.') %}
{% set net = prefix_parts[0] ~ '.' ~ prefix_parts[1] ~ '.' ~ prefix_parts[2] %}
{% set last = prefix_parts[3] | int %}
  - status__name: "Active"
    endpoints:
      - routing_instance__device__name: "{{ link[0] }}"
        source_ip__host: "{{ net }}.{{ last }}"
        autonomous_system__asn: {{ dc_asn_map[link[0]] }}
{% if not is_dci_link %}
        peer_group:
          "!get:name": "IPV4-UNDERLAY-PEERS"
          "!get:routing_instance__device__name": "{{ link[0] }}"
{% endif %}
        enabled: true
      - routing_instance__device__name: "{{ link[2] }}"
        source_ip__host: "{{ net }}.{{ last + 1 }}"
        autonomous_system__asn: {{ dc_asn_map[link[2]] }}
        peer_group:
          "!get:name": "IPV4-UNDERLAY-PEERS"
          "!get:routing_instance__device__name": "{{ link[2] }}"
        enabled: true
{% endif %}
{% endfor %}

# --- DC Overlay Peerings (eBGP, L2 EVPN, source = Loopback0) ---
{% for link in dc_all_links %}
{% if "Spine" in link[0] and "Leaf" in link[2] %}
{% set spine = dc_bgp_instances | selectattr("device", "equalto", link[0]) | first %}
{% set leaf = dc_bgp_instances | selectattr("device", "equalto", link[2]) | first %}
  - status__name: "Active"
    endpoints:
      - routing_instance__device__name: "{{ link[0] }}"
        source_ip__host: "{{ spine.router_id }}"
        autonomous_system__asn: {{ spine.asn }}
        peer_group:
          "!get:name": "EVPN-OVERLAY-PEERS"
          "!get:routing_instance__device__name": "{{ link[0] }}"
        enabled: true
      - routing_instance__device__name: "{{ link[2] }}"
        source_ip__host: "{{ leaf.router_id }}"
        autonomous_system__asn: {{ leaf.asn }}
        peer_group:
          "!get:name": "EVPN-OVERLAY-PEERS"
          "!get:routing_instance__device__name": "{{ link[2] }}"
        enabled: true
{% endif %}
{% endfor %}

# --- Inter-site EVPN peerings over MPLS-provided Loopback0 reachability ---
{% for peer in dci_evpn_peerings %}
  - status__name: "Active"
    endpoints:
      - routing_instance__device__name: "{{ peer.a_device }}"
        source_ip__host: "{{ peer.a_ip }}"
        autonomous_system__asn: {{ dc_asn_map[peer.a_device] }}
        peer_group:
          "!get:name": "EVPN-OVERLAY-PEERS"
          "!get:routing_instance__device__name": "{{ peer.a_device }}"
        enabled: true
      - routing_instance__device__name: "{{ peer.b_device }}"
        source_ip__host: "{{ peer.b_ip }}"
        autonomous_system__asn: {{ dc_asn_map[peer.b_device] }}
        peer_group:
          "!get:name": "EVPN-OVERLAY-PEERS"
          "!get:routing_instance__device__name": "{{ peer.b_device }}"
        enabled: true
{% endfor %}
